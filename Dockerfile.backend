# Stage 1: Build with Maven and Java 20 (Debian-based)
FROM maven:3.9.2-eclipse-temurin-20 AS build

# Set working directory
WORKDIR /app

# Install git
RUN apt-get update && apt-get install -y git

# Clone your backend repo
RUN git clone https://github.com/Kmadhu129/project_backend.git .

# Build the Spring Boot application
RUN mvn clean package -DskipTests

# Stage 2: Run with Debian-based JDK
FROM eclipse-temurin:20-jdk

# Set working directory
WORKDIR /app

# Copy the built JAR from build stage
COPY --from=build /app/target/*.jar app.jar

# Expose port
EXPOSE 8080

# Run the Spring Boot JAR
ENTRYPOINT ["java", "-jar", "app.jar"]
